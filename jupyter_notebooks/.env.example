# Copy to `.env` (same folder) and fill in what you use. `.env` is gitignored — never commit a key.
# With nothing set, every notebook still runs against the offline stand-in.

# OpenAI - real answers, small cost
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small

# Local models via Ollama (free) - install from ollama.com, then:
#   ollama pull qwen2.5:3b
#   ollama pull nomic-embed-text
# OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_URL=http://localhost:11434

# Force a provider instead of auto-detecting: openai | ollama | offline
# LLM_PROVIDER=offline

# Opt-in for the one notebook that can start a paid OpenAI fine-tuning job
# RUN_OPENAI_FINETUNE=1
